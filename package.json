{
  "name": "pi-ego-browser",
  "version": "0.1.0",
  "description": "ego-lite browser automation for the Pi coding agent: 35 ego_* tools over one isolated Chromium task-space per session.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RebotTan/pi-ego.git"
  },
  "homepage": "https://github.com/RebotTan/pi-ego#readme",
  "bugs": {
    "url": "https://github.com/RebotTan/pi-ego/issues"
  },
  "files": [
    "bin/ego-cast-worker.mjs",
    "src/",
    "runtime/",
    "extension/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "pi-package",
    "browser",
    "automation",
    "chromium"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "unit": "vitest run",
    "smoke:ci": "node scripts/smoke-tools.mjs && node scripts/smoke-lease.mjs && node scripts/smoke-sessions.mjs && node scripts/smoke-session-spaces.mjs && node scripts/smoke-observe.mjs",
    "build:worker": "esbuild src/worker/ego-cast-worker.ts --bundle --platform=node --format=esm --target=node22 --external:ws --outfile=bin/ego-cast-worker.mjs",
    "test": "npm run build:worker && vitest run && npm run smoke:ci && node scripts/smoke-status.mjs && node scripts/smoke-flow.mjs && node scripts/smoke-extended.mjs && node scripts/smoke-shutdown.mjs && node scripts/smoke-cast.mjs",
    "prepare": "npm run build:worker"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "esbuild": "^0.21.5"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
